# Application
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:5173

# Database (Docker PostgreSQL)
DATABASE_URL=postgresql://growth_operator:growth_operator_dev@localhost:5432/growth_operator?schema=public
# Dedicated test database. API tests MUST run here, never against DATABASE_URL.
# Create once: CREATE DATABASE growth_operator_test; then migrate it with
# DATABASE_URL=<this value> pnpm --filter @growth-operator/db db:migrate
TEST_DATABASE_URL=postgresql://growth_operator:growth_operator_dev@localhost:5432/growth_operator_test?schema=public

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# AI Providers (optional; at least one enables AI-composed features)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OpenRouter (OpenAI-compatible gateway; also offers free :free models).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: force all OpenRouter calls through one model, e.g.
# meta-llama/llama-3.3-70b-instruct:free for zero-cost prototyping.
# Unset = requested model passes through (gpt-4o-mini etc. work as-is).
OPENROUTER_MODEL=

# Security
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional social connectors (Content Brain inspiration, read-only OAuth).
# Everything empty = every platform honestly reports "Not configured".
# Generate the storage key once (64 hex chars), e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOCIAL_CONNECTOR_KEY=
# Where platforms redirect after authorization (must be allow-listed in each
# developer app). Defaults to ${API_URL}/api/v1/social/callback/<platform>.
SOCIAL_REDIRECT_URI=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=