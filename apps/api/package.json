{
  "name": "@growth-operator/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker/index.ts",
    "worker:start": "node dist/worker/index.js",
    "worker:once": "tsx src/worker/runOnce.ts",
    "build": "tsc",
    "seed:demo": "tsx src/seed-demo.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@growth-operator/ai": "workspace:*",
    "@growth-operator/business": "workspace:*",
    "@growth-operator/capabilities": "workspace:*",
    "@growth-operator/content": "workspace:*",
    "@growth-operator/db": "workspace:*",
    "@growth-operator/decision": "workspace:*",
    "@growth-operator/intelligence": "workspace:*",
    "@growth-operator/learning": "workspace:*",
    "@growth-operator/sales": "workspace:*",
    "@growth-operator/schemas": "workspace:*",
    "@growth-operator/shared": "workspace:*",
    "@growth-operator/social": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg-boss": "^12.35.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.5.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
