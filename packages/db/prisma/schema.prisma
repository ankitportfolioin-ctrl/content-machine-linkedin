// Workspace-level research-connector configuration. ONLY for genuine
// research connectors driven by ConnectorRegistry (REDDIT, GOOGLE_TRENDS,
// YOUTUBE, LINKEDIN, X, INSTAGRAM, TIKTOK, FACEBOOK, QUORA). Feed-driven
// sources (RSS, ATOM, HACKERNEWS, GITHUB_RELEASES, BLOG, SITE) keep
// FeedSource as their sole source of truth and must never get rows here.
//
// State separation (deliberate — never collapse into one status):
// - enabled: the user's ON/OFF choice. Missing row == DISABLED == never runs.
// - config: validated per-connector parameters (subreddits, topics, ...).
// - lastProbeStatus/lastProbeAt/lastProbeError: outcome of the last real
//   verification probe only. A passing probe proves that one probe request
//   worked; it never promises future runtime data.
// - Authentication (OAuth account state) lives in SocialConnection and is
//   joined at read time, never copied here. A connected account never
//   implies research is enabled.
model WorkspaceConnector {
  id              String    @id @default(uuid())
  workspaceId     String
  sourceType      String    @db.VarChar(50)
  enabled         Boolean   @default(false)
  config          Json      @default("{}")
  lastProbeStatus String    @db.VarChar(50) @default("NEVER_PROBED")
  lastProbeAt     DateTime?
  lastProbeError  String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sourceType])
  @@index([workspaceId])
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  YOUTUBE
  X
  REDDIT
}

enum SocialConnectionStatus {
  CONNECTED
  PAUSED
  ERROR
  EXPIRED
}

// Short-lived OAuth authorization states (CSRF protection for Connect).
// Only a SHA-256 hash of the state is stored — the raw value is a bearer
// credential and never persists. Rows are single-use (deleted on consume)
// and expire after 10 minutes; stale rows are pruned opportunistically.
// Database-backed (not in-memory) so server restarts and multi-instance
// deployments cannot strand or split in-flight authorization attempts.
model OAuthState {
  stateHash   String         @id @db.VarChar(64)
  workspaceId String
  userId      String
  platform    SocialPlatform
  expiresAt   DateTime
  createdAt   DateTime       @default(now())

  @@index([expiresAt])
  @@index([workspaceId])
}

// Optional OAuth connections to social platforms (read-only). Tokens are
// stored AES-256-GCM encrypted and never leave the server. Pulled items live
// in SocialPost with full source attribution. Disconnecting deletes the
// connection row (tokens die with it); pulled posts are KEPT as inspiration
// and keep pointing at the platform + original URL.
model SocialConnection {
  id               String                  @id @default(uuid())
  workspaceId      String
  platform         SocialPlatform
  accountLabel     String?                 @db.VarChar(200)
  encryptedAccess  String                  @db.Text
  encryptedRefresh String?                 @db.Text
  tokenExpiresAt   DateTime?
  status           SocialConnectionStatus  @default(CONNECTED)
  active           Boolean                 @default(true)
  lastPulledAt     DateTime?
  lastError        String?                 @db.Text
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts            SocialPost[]

  @@unique([workspaceId, platform])
  @@index([workspaceId])
}

model SocialPost {
  id           String         @id @default(uuid())
  workspaceId  String
  connectionId String?
  platform     SocialPlatform
  externalId   String         @db.VarChar(500)
  url          String?        @db.VarChar(2048)
  title        String?        @db.VarChar(500)
  text         String?        @db.Text
  author       String?        @db.VarChar(200)
  publishedAt  DateTime?
  mediaKind    String?        @db.VarChar(50)
  hashtags     String[]       @default([])
  fetchedAt    DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection   SocialConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, platform, externalId])
  @@index([workspaceId])
  @@index([workspaceId, platform])
  @@index([connectionId])
}

model DailyRun {
  id          String         @id @default(uuid())
  workspaceId String
  runDate     DateTime       @db.Date
  status      DailyRunStatus @default(STARTED)
  startedAt   DateTime       @default(now())
  finishedAt  DateTime?
  summary     Json?
  error       String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages      RunStage[]
  snapshots   ApprovalSnapshot[]

  @@unique([workspaceId, runDate])
  @@index([workspaceId, runDate])
}

model RunStage {
  id          String         @id @default(uuid())
  workspaceId String
  dailyRunId  String
  stage       RunStageName
  status      RunStageStatus @default(PENDING)
  counts      Json?
  durationMs  Int?
  error       String?        @db.Text
  startedAt   DateTime?
  finishedAt  DateTime?
  attempt     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dailyRun    DailyRun       @relation(fields: [dailyRunId], references: [id], onDelete: Cascade)

    @@unique([workspaceId, dailyRunId, stage, attempt])
    @@index([workspaceId, dailyRunId])
  }

  // Release gate: worker liveness heartbeat. Intentionally NOT
  // workspace-scoped: it describes worker PROCESSES (infrastructure), not
  // tenant data — scoping it per workspace would be fake isolation. Rows are
  // tiny (one per live worker) and pruned by age on every beat, so the table
  // stays small by construction. Never stores credentials or payloads.
  model WorkerHeartbeat {
    id          String   @id @default(uuid())
    workerId    String   @unique @db.VarChar(200)
    startedAt   DateTime
    lastBeatAt  DateTime
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([lastBeatAt])
  }

  // WP9 Phase 1: Autonomous Operator Cycle. Separate from DailyRun to support
  // on-demand execution with explicit idempotency keys. Reuses the same
  // STAGE_ORDER and stage execution logic but with user-controlled triggers.
  enum OperatorCycleStatus {
    QUEUED
    RUNNING
    PAUSED
    COMPLETED
    PARTIAL
    FAILED
    CANCELLED
  }

  enum OperatorCycleStageName {
    RESEARCH
    DECISION
    CONTENT
    SALES
    APPROVAL
    EXECUTION
    OBSERVE
    LEARN
    FINALIZE
  }

  enum OperatorCycleStageStatus {
    PENDING
    RUNNING
    SUCCEEDED
    SKIPPED
    FAILED
  }

  model OperatorCycle {
    id              String                 @id @default(uuid())
    workspaceId     String
    idempotencyKey  String                 @db.VarChar(100)
    status          OperatorCycleStatus    @default(QUEUED)
    currentStage    OperatorCycleStageName?
    requestedAt     DateTime               @default(now())
    startedAt       DateTime?
    completedAt     DateTime?
    error           String?                @db.Text
    errorStage      OperatorCycleStageName?
    correlationId   String?                @db.VarChar(100)
    result          Json?
    createdAt       DateTime               @default(now())
    updatedAt       DateTime               @updatedAt

    workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    stages          OperatorCycleStage[]

    @@unique([workspaceId, idempotencyKey])
    @@index([workspaceId, status])
    @@index([workspaceId, requestedAt])
  }

  model OperatorCycleStage {
    id              String                   @id @default(uuid())
    workspaceId     String
    cycleId         String
    stage           OperatorCycleStageName
    status          OperatorCycleStageStatus @default(PENDING)
    counts          Json?
    durationMs      Int?
    error           String?                  @db.Text
    startedAt       DateTime?
    finishedAt      DateTime?
    attempt         Int                      @default(1)
    createdAt       DateTime                 @default(now())
    updatedAt       DateTime                 @updatedAt

    workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    cycle           OperatorCycle            @relation(fields: [cycleId], references: [id], onDelete: Cascade)

    @@unique([workspaceId, cycleId, stage, attempt])
    @@index([workspaceId, cycleId])
  }

  model ApprovalSnapshot {
    // Batch 3 (#12): frozen approval state per daily run. Items are plain
    // copied values (ids, scores, reasons, version identifiers) captured at
    // snapshot time — never live references — so later human decisions
    // cannot silently rewrite what the run saw. One row per run (upsert);
    // resume skips SUCCEEDED stages, so a snapshot is written once.
    id          String   @id @default(uuid())
    workspaceId String
    dailyRunId  String
    runDate     DateTime @db.Date
    capturedAt  DateTime @default(now())
    items       Json
    counts      Json?
    createdAt   DateTime @default(now())

    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    dailyRun    DailyRun  @relation(fields: [dailyRunId], references: [id], onDelete: Cascade)

    @@unique([workspaceId, dailyRunId])
    @@index([workspaceId])
  }

  model OnboardingState {
  id             String    @id @default(uuid())
  workspaceId    String    @unique
  currentStep    String    @default("profile") @db.VarChar(50)
  completedSteps String[]  @default([])
  profileDone    Boolean   @default(false)
  audienceDone   Boolean   @default(false)
  pillarsDone    Boolean   @default(false)
  offersDone     Boolean   @default(false)
  sourcesDone    Boolean   @default(false)
  leadsDone      Boolean   @default(false)
  policyDone     Boolean   @default(false)
  scheduleDone   Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

