model User {
  id            String    @id @default(uuid())
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @db.VarChar(255)
  name          String    @db.VarChar(100)
  avatarUrl     String?   @db.VarChar(2048)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  memberships   WorkspaceMembership[]
  profiles      Profile[]
  contentIdeas  ContentIdea[]       @relation("ContentIdeaAuthor")
  contentDrafts ContentDraft[]      @relation("ContentDraftAuthor")
  contentVersions ContentVersion[]  @relation("ContentVersionAuthor")
  leads         Lead[]              @relation("LeadAssignee")
  conversations Conversation[]      @relation("ConversationUser")
  messages      Message[]           @relation("MessageSender")
  opportunities PipelineOpportunity[] @relation("OpportunityOwner")
  analyticsEvents AnalyticsEvent[]
  learningSignals LearningSignal[]
  opportunityFeedbacks OpportunityFeedback[]

  @@index([email])
  @@index([isActive])
}

model BusinessProfile {
  id              String   @id @default(uuid())
  workspaceId     String
  name            String   @db.VarChar(100)
  description     String?  @db.Text
  mission         String?  @db.Text
  products        Json?    @default("[]")
  services        Json?    @default("[]")
  skills          Json?    @default("[]")
  ebooks          Json?    @default("[]")
  guides          Json?    @default("[]")
  targetOutcomes  Json?    @default("[]")
  monetizationGoals Json?  @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId])
  @@index([workspaceId])
}

model BrandProfile {
