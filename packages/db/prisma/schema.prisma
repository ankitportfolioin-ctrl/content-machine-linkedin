// Step B: Autonomous Daily Loop foundation. Every model here is
// workspace-scoped (workspaceId on every row, Cascade delete).
// No changes were made to any pre-existing model or table.
model WorkspaceSettings {
  id                  String   @id @default(uuid())
  workspaceId         String   @unique
  timezone            String   @default("UTC") @db.VarChar(100)
  dailyRunTime        String   @default("06:00") @db.VarChar(5)
  dailyLlmCallCap     Int      @default(50)
  dailyFetchCap       Int      @default(100)
  dailyPreparationCap Int      @default(20)
  // Batch 2 (E): execution is a distinct budget category from research
  // (LLM calls) and preparation (internal artifacts). No LinkedIn execution
  // integration exists, so the default 0 keeps execution unavailable.
  dailyExecutionCap   Int      @default(0)
  paused              Boolean  @default(false)
  killSwitch          Boolean  @default(false)
  autonomyTier        Int      @default(0)
  scheduleConfigured  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AutonomyPolicy {
  id                      String   @id @default(uuid())
  workspaceId             String   @unique
  tier1PostingEnabled     Boolean  @default(false)
  tier1PostingDailyCap    Int      @default(1)
  tier1RequireApprovedPost Boolean @default(true)
  tier2HumanApprovalAck   Boolean  @default(false)
  // Batch 2 (B): explicit, persisted, workspace-scoped auto-preparation
  // policy. autoPrepareApprovedWork covers work justified by prior human
  // judgment (imported lead, triaged opportunity, approved strategy/plan).
  // autoPrepareColdWork covers untouched opportunities/prospects and new
  // recommendations without prior judgment (default OFF). Quota caps daily
  // automatic preparations; exhaustion is a policy decision, not an error.
  autoPrepareApprovedWork Boolean  @default(true)
  autoPrepareColdWork     Boolean  @default(false)
  dailyAutoPreparationQuota Int    @default(10)
  updatedBy               String?  @db.VarChar(100)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

