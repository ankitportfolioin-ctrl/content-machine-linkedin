generator client {
  provider = "prisma-client-js"
  output   = "../dist/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ContentStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ContentFormat {
  POST
  ARTICLE
  CAROUSEL
  VIDEO
  POLL
}

enum LeadStatus {
  NEW
  CONTACTED
  CONNECTED
  RESPONDING
  QUALIFIED
  DISQUALIFIED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum PipelineStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum LearningSignalSourceType {
  CONTENT_PERFORMANCE
  ENGAGEMENT
  CONVERSION
  FEEDBACK
}

enum SourceType {
  ARTICLE
  RSS
  ATOM
  SITEMAP
  WEBSITE
  USER_URL
}

enum SourceStatus {
  ACTIVE
  FAILED
  BLOCKED
  STALE
}

enum PublishedAtConfidence {
  VERIFIED
  INFERRED
  UNKNOWN
}

enum ContentType {
  HTML
  RSS_XML
  ATOM_XML
  SITEMAP_XML
  TEXT
}

enum ExtractionMethod {
  HTML
  RSS
  ATOM
  SITEMAP
  TEXT
  USER_PROVIDED
}

enum ExtractionStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum ClaimType {
  FACT
  OPINION
  PREDICTION
  RECOMMENDATION
  OBSERVATION
  STATISTIC
}

enum ClaimStatus {
  SUPPORTED
  CONTRADICTED
  UNCERTAIN
}

enum TrendStatus {
  INSUFFICIENT_HISTORY
  EMERGING
  RELEVANT
  TRENDING
  STALE
}

enum OpportunityStatus {
  NEW
  REVIEWED
  CONVERTED
  DISMISSED
}

enum GapType {
  AUDIENCE
  TOPIC
  FORMAT
  ANGLE
  DEPTH
  EVIDENCE
}

enum FeedbackType {
  USEFUL
  NOT_USEFUL
  ALREADY_COVERED
  WRONG_AUDIENCE
  WEAK_EVIDENCE
  NOT_TIMELY
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @db.VarChar(255)
  name          String    @db.VarChar(100)
  avatarUrl     String?   @db.VarChar(2048)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  memberships   WorkspaceMembership[]
  profiles      Profile[]
  contentIdeas  ContentIdea[]       @relation("ContentIdeaAuthor")
  contentDrafts ContentDraft[]      @relation("ContentDraftAuthor")
  contentVersions ContentVersion[]  @relation("ContentVersionAuthor")
  leads         Lead[]              @relation("LeadAssignee")
  conversations Conversation[]      @relation("ConversationUser")
  messages      Message[]           @relation("MessageSender")
  opportunities PipelineOpportunity[] @relation("OpportunityOwner")
  analyticsEvents AnalyticsEvent[]
  learningSignals LearningSignal[]
  opportunityFeedbacks OpportunityFeedback[]

  @@index([email])
  @@index([isActive])
}

model Workspace {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships         WorkspaceMembership[]
  profiles            Profile[]
  icps                ICP[]
  contentIdeas        ContentIdea[]
  contentDrafts       ContentDraft[]
  contentVersions     ContentVersion[]
  leads               Lead[]
  conversations       Conversation[]
  messages            Message[]
  opportunities       PipelineOpportunity[]
  analyticsEvents     AnalyticsEvent[]
  learningSignals     LearningSignal[]
  intelligenceSources IntelligenceSource[]
  sourceDocuments     SourceDocument[]
  sourceClaims        SourceClaim[]
  topics              Topic[]
  topicMentions       TopicMention[]
  trendSignals        TrendSignal[]
  contentOpportunities ContentOpportunity[]
  contentGaps         ContentGap[]
  opportunityFeedbacks OpportunityFeedback[]

  @@index([slug])
  @@index([isActive])
}

model WorkspaceMembership {
  id        String   @id @default(uuid())
  userId    String
  workspaceId String
  role      UserRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
  @@index([role])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  linkedinUrl String?  @unique @db.VarChar(2048)
  headline    String?  @db.VarChar(220)
  summary     String?  @db.Text
  industry    String?  @db.VarChar(100)
  location    String?  @db.VarChar(100)
  avatarUrl   String?  @db.VarChar(2048)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([linkedinUrl])
}

model ICP {
  id          String   @id @default(uuid())
  workspaceId String
  name        String   @db.VarChar(100)
  description String?  @db.Text
  criteria    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model ContentIdea {
  id          String        @id @default(uuid())
  workspaceId String
  authorId    String
  title       String       @db.VarChar(200)
  description String?      @db.Text
  angle       String?      @db.VarChar(500)
  format      ContentFormat?
  status      ContentStatus @default(DRAFT)
  tags        String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  publishedAt DateTime?

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User          @relation("ContentIdeaAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  drafts      ContentDraft[]

  @@index([workspaceId])
  @@index([authorId])
  @@index([status])
  @@index([createdAt])
}

model ContentDraft {
  id              String   @id @default(uuid())
  workspaceId     String
  contentIdeaId   String
  authorId        String
  body            String   @db.Text
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentIdea     ContentIdea   @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)
  author          User          @relation("ContentDraftAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  versions        ContentVersion[]

  @@unique([contentIdeaId, version])
  @@index([workspaceId])
  @@index([contentIdeaId])
  @@index([authorId])
}

model ContentVersion {
  id              String   @id @default(uuid())
  workspaceId     String
  contentDraftId  String
  authorId        String
  body            String   @db.Text
  version         Int
  changeSummary   String?  @db.VarChar(500)
  createdAt       DateTime @default(now())

  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentDraft    ContentDraft  @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)
  author          User          @relation("ContentVersionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([contentDraftId, version])
  @@index([workspaceId])
  @@index([contentDraftId])
  @@index([authorId])
}

model Lead {
  id            String     @id @default(uuid())
  workspaceId   String
  assigneeId    String?
  linkedinUrl   String     @unique @db.VarChar(2048)
  name          String     @db.VarChar(100)
  headline      String?    @db.VarChar(220)
  company       String?    @db.VarChar(200)
  location      String?    @db.VarChar(100)
  status        LeadStatus @default(NEW)
  tags          String[]   @default([])
  notes         String?    @db.Text
  lastContactAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee      User?       @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  opportunities PipelineOpportunity[]

  @@index([workspaceId])
  @@index([assigneeId])
  @@index([status])
  @@index([linkedinUrl])
  @@index([createdAt])
}

model Conversation {
  id            String   @id @default(uuid())
  workspaceId   String
  leadId        String
  userId        String
  subject       String?  @db.VarChar(200)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user          User        @relation("ConversationUser", fields: [userId], references: [id], onDelete: Restrict)
  messages      Message[]

  @@index([workspaceId])
  @@index([leadId])
  @@index([userId])
  @@index([lastMessageAt])
}

model Message {
  id                String          @id @default(uuid())
  workspaceId       String
  conversationId    String
  senderId          String
  body              String          @db.Text
  direction         MessageDirection
  linkedinMessageId String?         @unique @db.VarChar(100)
  sentAt            DateTime        @default(now())
  createdAt         DateTime        @default(now())

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation      Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            User            @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([conversationId])
  @@index([senderId])
  @@index([sentAt])
}

model PipelineOpportunity {
  id                String         @id @default(uuid())
  workspaceId       String
  leadId            String
  ownerId           String
  name              String         @db.VarChar(100)
  stage             PipelineStage  @default(PROSPECTING)
  value             Decimal?       @db.Decimal(12, 2)
  expectedCloseDate DateTime?
  probability       Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  closedAt          DateTime?

  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead              Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner             User           @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([leadId])
  @@index([ownerId])
  @@index([stage])
  @@index([createdAt])
}

model AnalyticsEvent {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String?
  eventType   String   @db.VarChar(100)
  eventName   String   @db.VarChar(100)
  properties  Json?
  timestamp   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId])
  @@index([eventType])
  @@index([eventName])
  @@index([timestamp])
}

model LearningSignal {
  id            String                    @id @default(uuid())
  workspaceId   String
  userId        String?
  sourceType    LearningSignalSourceType
  sourceId      String
  signalType    String                    @db.VarChar(100)
  signalValue   Float
  metadata      Json?
  createdAt     DateTime                  @default(now())

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId])
  @@index([sourceType])
  @@index([sourceId])
  @@index([signalType])
  @@index([createdAt])
}

model IntelligenceSource {
  id                    String            @id @default(uuid())
  workspaceId           String
  url                   String            @db.VarChar(2048)
  canonicalUrl          String            @db.VarChar(2048)
  sourceType            SourceType
  title                 String?           @db.VarChar(500)
  publisher             String?           @db.VarChar(200)
  author                String?           @db.VarChar(200)
  publishedAt           DateTime?
  publishedAtConfidence PublishedAtConfidence @default(UNKNOWN)
  description           String?           @db.Text
  contentHash           String            @db.VarChar(64)
  urlHash               String            @db.VarChar(64)
  status                SourceStatus      @default(ACTIVE)
  lastFetchedAt         DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  workspace             Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents             SourceDocument[]
  claims                SourceClaim[]
  topicMentions         TopicMention[]

  @@unique([workspaceId, canonicalUrl])
  @@unique([workspaceId, contentHash])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, sourceType])
  @@index([workspaceId, lastFetchedAt])
}

model SourceDocument {
  id                  String            @id @default(uuid())
  workspaceId         String
  sourceId            String
  rawContent          String            @db.Text
  cleanContent        String            @db.Text
  contentType         ContentType
  wordCount           Int
  language            String?           @db.VarChar(10)
  extractionMethod    ExtractionMethod
  extractionStatus    ExtractionStatus
  extractionWarnings  String[]
  fetchedAt           DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source              IntelligenceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  claims              SourceClaim[]

  @@index([workspaceId])
  @@index([sourceId])
  @@index([workspaceId, extractionStatus])
}

model SourceClaim {
  id                  String        @id @default(uuid())
  workspaceId         String
  sourceId            String
  documentId          String
  claimText           String        @db.Text
  claimType           ClaimType
  evidenceText        String        @db.Text
  evidenceLocation    String?       @db.Text
  confidence          Float
  status              ClaimStatus   @default(UNCERTAIN)
  provenance          Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  workspace           Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source              IntelligenceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  document            SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sourceId])
  @@index([documentId])
  @@index([workspaceId, claimType])
  @@index([workspaceId, status])
}

model Topic {
  id              String        @id @default(uuid())
  workspaceId     String
  name            String        @db.VarChar(200)
  canonicalName   String        @db.VarChar(200)
  description     String?       @db.Text
  aliases         String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mentions        TopicMention[]
  trendSignals    TrendSignal[]
  opportunities   ContentOpportunity[]
  gaps            ContentGap[]

  @@unique([workspaceId, canonicalName])
  @@index([workspaceId])
  @@index([workspaceId, canonicalName])
}

model TopicMention {
  id              String    @id @default(uuid())
  workspaceId     String
  topicId         String
  sourceId        String
  mentionStrength Float
  relevanceScore  Float
  context         String?   @db.Text
  createdAt       DateTime  @default(now())

  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  topic           Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  source          IntelligenceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([topicId])
  @@index([sourceId])
  @@index([workspaceId, topicId])
}

model TrendSignal {
  id                      String      @id @default(uuid())
  workspaceId             String
  topicId                 String
  status                  TrendStatus @default(INSUFFICIENT_HISTORY)
  mentionCount            Int
  sourceCount             Int
  firstSeenAt             DateTime
  lastSeenAt              DateTime
  recencyScore            Float
  sourceDiversityScore    Float
  frequencyScore          Float
  evidenceSummary         String?     @db.Text
  calculatedAt            DateTime    @default(now())

  workspace               Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  topic                   Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([topicId])
  @@index([workspaceId, status])
  @@index([workspaceId, calculatedAt])
}

model ContentOpportunity {
  id                  String            @id @default(uuid())
  workspaceId         String
  topicId             String
  title               String            @db.VarChar(300)
  thesis              String            @db.Text
  problem             String            @db.Text
  audience            String            @db.Text
  angle               String            @db.Text
  objective           String            @db.Text
  contentFormat       String?           @db.VarChar(50)
  opportunityScore    Float
  status              OpportunityStatus @default(NEW)
  sourceIds           Json
  claimIds            Json
  trendSignalIds      Json
  reasoning           String            @db.Text
  evidenceSummary     String            @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  topic               Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([topicId])
  @@index([workspaceId, status])
  @@index([workspaceId, opportunityScore])
}

model ContentGap {
  id              String    @id @default(uuid())
  workspaceId     String
  topicId         String
  gapType         GapType
  description     String    @db.Text
  importanceScore Float
  evidence        String    @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  topic           Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([topicId])
  @@index([workspaceId, gapType])
}

model OpportunityFeedback {
  id          String        @id @default(uuid())
  workspaceId String
  opportunityId String
  userId      String
  feedback    FeedbackType
  reason      String?       @db.Text
  createdAt   DateTime      @default(now())

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([opportunityId])
  @@index([userId])
}