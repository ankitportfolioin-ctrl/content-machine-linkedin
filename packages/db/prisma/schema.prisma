  audience            String            @db.Text
  angle               String            @db.Text
  objective           String            @db.Text
  contentFormat       String?           @db.VarChar(50)
  opportunityScore    Float
  status              OpportunityStatus @default(NEW)
  sourceIds           Json
  claimIds            Json
  trendSignalIds      Json
    reasoning           String            @db.Text
    evidenceSummary     String            @db.Text
    // Batch 3: signal provenance. Opportunities proposed from sales-side
    // signals record their origin here so the same signal never spawns
    // duplicates (unique per workspace+origin, any status) and triage can
    // trace NEW → idea back to the originating signal. NULL for
    // feed-derived opportunities. NULLs stay mutually distinct in Postgres,
    // so legacy rows are unaffected.
    originKind          String?           @db.VarChar(50)
    originId            String?           @db.VarChar(200)
    createdAt           DateTime          @default(now())
    updatedAt           DateTime          @updatedAt
  
    workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    topic               Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
    @@index([workspaceId])
    @@index([topicId])
    @@index([workspaceId, status])
    @@unique([workspaceId, originKind, originId])
  @@index([workspaceId, opportunityScore])
}

