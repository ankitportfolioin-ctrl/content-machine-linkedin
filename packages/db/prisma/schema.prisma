model ContentDNA {
  id                    String           @id @default(uuid())
  workspaceId           String
  contentIdeaId         String?          @unique
  contentDraftId        String?          @unique
  contentVersionId      String?          @unique
  
  topic                 String?          @db.VarChar(200)
  subtopic              String?          @db.VarChar(200)
  audienceSegmentId     String?
  skillLevel            String?          @db.VarChar(50)
  pillar                String?          @db.VarChar(100)
  format                ContentDNAFormat?
  angle                 String?          @db.Text
  hookType              HookType?
  hook                  String?          @db.Text
  hookLength            Int?
  title                 String?          @db.VarChar(300)
  structure             Json?
  bodyLength            Int?
  visualType            String?          @db.VarChar(50)
  visualConcept         String?          @db.Text
  ctaType               CTAType?
  cta                   String?          @db.Text
  hashtags              String[]
  sourceIds             Json?
  freshness             String?          @db.VarChar(50)
  publishTime           DateTime?
  stage                 ContentStage     @default(RESEARCH)
  
  impressions           Int?
  reach                 Int?
  reactions             Int?
  comments              Int?
  reposts               Int?
  saves                 Int?
  sends                 Int?
  linkClicks            Int?
  profileViews          Int?
  followerGain          Int?
  businessActions       Int?
  
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  workspace             Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentIdea           ContentIdea?     @relation("ContentIdeaDNA", fields: [contentIdeaId], references: [id], onDelete: Cascade)
  contentDraft          ContentDraft?    @relation("ContentDraftDNA", fields: [contentDraftId], references: [id], onDelete: Cascade)
  contentVersion        ContentVersion?  @relation("ContentVersionDNA", fields: [contentVersionId], references: [id], onDelete: Cascade)
  audienceSegment       AudienceSegment? @relation(fields: [audienceSegmentId], references: [id], onDelete: SetNull)
  stageHistories        ContentStageHistory[]
  experimentsAsControl  Experiment[]     @relation("ExperimentControl")
  experimentsAsVariant  Experiment[]     @relation("ExperimentVariant")

  @@index([workspaceId])
  @@index([contentIdeaId])
  @@index([contentDraftId])
  @@index([contentVersionId])
  @@index([workspaceId, stage])
  @@index([workspaceId, pillar])
  @@index([workspaceId, format])
}

