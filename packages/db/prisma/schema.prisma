  // Batch 2 (A): acceptance authorizes preparation of internal work from
  // this recommendation. It is NOT execution approval and implies no
  // external action (no send, publish, or contact).
  acceptedAt    DateTime?
  acceptedBy    String?  @db.VarChar(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Audit / Provenance fields
  decidedBy     String?  @db.VarChar(100)  // actor: 'system' | userId | 'ai'
  decidedAt     DateTime?
  decisionReason String? @db.Text          // human-provided reason for transition
  evidenceRefs  String[] @default([])      // refs to evidence used in decision
  model         String?  @db.VarChar(100)  // model name if AI was involved
  modelVersion  String?  @db.VarChar(50)   // model version if AI was involved
  policySnapshot Json?                    // relevant policy state at decision time

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, identityKey])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, score])
}

model LearningProposal {
  id                   String                 @id @default(uuid())
  workspaceId          String
  dimension            String                 @db.VarChar(100)
  observedPattern      String                 @db.Text
  supportingMeasurements Json
  sourceMetricIds      String[]               @default([])
  sampleSize           Int
  denominator          Int?
  proposedAdjustment   Float
  reason               String                 @db.Text
  confidence           Float?
  status               LearningProposalStatus @default(PROPOSED)
  confirmedBy          String?
  confirmedAt          DateTime?
  // Batch 2 (C): evidence maturity ladder. Decision status (PROPOSED /
  // CONFIRMED / REJECTED / REVOKED) stays separate from evidence maturity:
  // UNKNOWN -> OBSERVED -> REPEATED_SIGNAL -> HYPOTHESIS -> EXPERIMENT ->
  // SUPPORTED_PATTERN -> CONFIRMED. A single strong observation must never
  // jump straight to CONFIRMED; CONFIRMED requires the existing human
  // confirm transition. evidenceCount tracks recorded occurrences.
  maturity             String                 @default("HYPOTHESIS") @db.VarChar(30)
  evidenceCount        Int                    @default(1)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  workspace            Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, dimension])
  @@index([workspaceId, maturity])
}

// Batch 2 (D): provenance-based attribution. NEVER overclaim causality:
// DIRECT = authoritative evidence explicitly connects the records;
// INFERRED = documented logical connection but no direct proof;
// UNKNOWN = no defensible connection. Upgrades (UNKNOWN -> INFERRED ->
// DIRECT) require new evidence; reach/impressions alone never qualify.
model AttributionLink {
  id              String   @id @default(uuid())
  workspaceId     String
  sourceType      String   @db.VarChar(100)
  sourceId        String   @db.VarChar(100)
  targetType      String   @db.VarChar(100)
  targetId        String   @db.VarChar(100)
  attributionType String   @default("UNKNOWN") @db.VarChar(20)
  evidenceRefs    String[] @default([])
  reason          String?  @db.Text
  recordedBy      String?  @db.VarChar(100)
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sourceType, sourceId, targetType, targetId])
  @@index([workspaceId])
  @@index([workspaceId, attributionType])
  @@index([workspaceId, targetType, targetId])
  @@index([workspaceId, sourceType, sourceId])
}

// Batch 2 (B): every automatic preparation carries a traceable
// authorization source. Quota enforcement counts PREPARED rows per
// workspace per day; SKIPPED rows record why preparation did not happen.
model PreparationLog {
  id                  String   @id @default(uuid())
  workspaceId         String
  kind                String   @db.VarChar(100)
  subjectType         String   @db.VarChar(100)
  subjectId           String?  @db.VarChar(100)
  resultType          String?  @db.VarChar(100)
  resultId            String?  @db.VarChar(100)
  authorizationSource String   @db.VarChar(50)
  authorizationReason String   @db.Text
  status              String   @default("PREPARED") @db.VarChar(20)
  skipReason          String?  @db.Text
  createdAt           DateTime @default(now())

  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, subjectType, subjectId])
}

// Batch 2 (F): explicit COMMENT -> classification -> audience signal ->
// sales intelligence bridge. A LEAD_SIGNAL comment may produce a sales
// intelligence signal for HUMAN REVIEW — never an automatic prospect,
// outreach, conversation, or revenue record.
model CommentSalesSignal {
  id               String   @id @default(uuid())
  workspaceId      String
  commentId        String
  audienceSignalId String?
  signalType       String   @default("COMMENT_LEAD_SIGNAL") @db.VarChar(100)
  evidence         String   @db.Text
  reason           String   @db.Text
  status           String   @default("PENDING_REVIEW") @db.VarChar(30)
  reviewedBy       String?  @db.VarChar(100)
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  comment          Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, commentId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([commentId])
}