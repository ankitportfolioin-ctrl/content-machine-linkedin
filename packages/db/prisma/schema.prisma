  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId])
  @@index([workspaceId])
}

model AudienceSegment {
  id              String             @id @default(uuid())
  workspaceId     String
  name            String             @db.VarChar(100)
  type            AudienceSegmentType
  description     String?            @db.Text
  problems        Json?              @default("[]")
  goals           Json?              @default("[]")
  interests       Json?              @default("[]")
  tools           Json?              @default("[]")
  skills          Json?              @default("[]")
  painPoints      Json?              @default("[]")
  motivations     Json?              @default("[]")
  contentPreferences Json?           @default("[]")
  isDefault       Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedProblems  Problem[]
  contentDNAs     ContentDNA[]
  audienceSignals AudienceSignal[]

  @@index([workspaceId])
  @@index([workspaceId, type])
}

model Problem {
  id              String   @id @default(uuid())
  workspaceId     String
  audienceSegmentId String?
  title           String   @db.VarChar(300)
  description     String?  @db.Text
  severity        Int      @default(5)
  frequency       String?  @db.VarChar(50)
  source          String?  @db.VarChar(100)
  evidence        String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  audienceSegment AudienceSegment?   @relation(fields: [audienceSegmentId], references: [id], onDelete: SetNull)
  products        Product[]

  @@index([workspaceId])
  @@index([audienceSegmentId])
}

model Product {
  id              String   @id @default(uuid())
  workspaceId     String
  problemId       String?
  name            String   @db.VarChar(200)
  description     String?  @db.Text
  type            String   @db.VarChar(50)
  price           Decimal? @db.Decimal(10, 2)
  url             String?  @db.VarChar(2048)
  features        Json?    @default("[]")
  targetOutcomes  Json?    @default("[]")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  problem         Problem?  @relation(fields: [problemId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([problemId])
